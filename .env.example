# ==========================================================================
# 数字孪生工厂 —— 统一环境配置（后端 FastAPI 与前端 Vite 共用此文件）
# 本地开发(vite dev / uvicorn)与构建(vite build)均从本文件取值。
# 缺项时使用代码内置默认值（与历史口径一致），非法值会在启动时报错指出。
# 复制本文件为 .env 后按需修改；.env 已被 .gitignore 忽略。
# ==========================================================================

# ---- 服务监听 ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ---- 前端访问后端的地址（浏览器侧）----
# 留空 = 走前端同源代理（默认，换机器/换端口都无需改动）
VITE_API_BASE_URL=

# ---- 统计口径（改造前后默认值保持历史行为一致，勿轻易改动）----
# 班次边界：24小时制整点，逗号分隔，按从小到大排列；首尾跨 0 点自动衔接
STAT_SHIFT_START_HOURS=0,8,16
# 采样间隔：模拟器采样/推送一次的秒数
STAT_SAMPLE_INTERVAL=1
# 保留时长：产量/效率统计历史保留的时间长度（秒）。历史默认 60 个采样点 = 60s
STAT_RETENTION_SECONDS=60
# 内存兜底上限（条数），防止保留窗口异常时日志无限增长
PRODUCTION_LOG_MAXLEN=10000
ANOMALY_LOG_MAXLEN=2000

# ---- 模拟器 ----
# 设为 false 可关闭内置模拟数据（对接真实数据源时使用）
SIMULATOR_ENABLED=true
# 随机种子：留空则每次随机；填整数可复现同一套统计结果（便于与历史数据比对）
STAT_RANDOM_SEED=
