# ============================================================
# 产量与效率统计 —— 统一口径配置（后端运行时 / 前端构建时共用）
# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略
# ============================================================

# ---- 统计口径（产量 / OEE）----
# 班次边界：班次开始的整点小时(0-23)。默认 0 = 零点跨日，与历史"今日产量"口径一致
STAT_SHIFT_START_HOUR=0
# 采样间隔：模拟器采样/推送周期（秒，0.1-60）。默认 1
STAT_SAMPLE_INTERVAL_SEC=1
# 保留时长：产量日志在内存中的保留时长（秒，>=1）。默认 60，等价于改造前 60 个采样点
STAT_RETENTION_SEC=60

# ---- 后端服务 ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ---- 前端 ----
# API/WS 基础地址。留空 = 使用当前页面同源地址（开发时经 Vite 代理转发到后端，
# 换机器、换端口都无需修改）；独立部署时可写成 http://192.168.1.10:8000
VITE_API_BASE=
